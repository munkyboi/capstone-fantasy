digraph UML {
 graph [rankdir=LR, bgcolor="white", pad=0.35, nodesep=0.6, ranksep=0.9];
 node [shape=record, fontname="Helvetica", fontsize=12, color="#324a70", style=filled, fillcolor="#f4f7fc"];
 edge [fontname="Helvetica", fontsize=10, color="#506781"];
 Main [label="{{game.Main|+main(String[]): void}}"];
 BattlePanel [label="{{game.view.BattlePanel|-battle: Battle|-actionPoints: Map|-enemyPoints: Map|+start(GameProgress): void}}"];
 BattleScene [label="{{game.view.BattleScene|-state: State|+paintComponent(Graphics): void}}"];
 Overlays [label="{{game.view.BattleHudOverlays|-state: BattleScene.State|-hudHeight: IntSupplier|~drawRewards(Graphics2D): void}}"];
 Camp [label="{{game.view.CampPanel|+open(GameProgress, boolean): void|+resume(GameProgress, boolean): void}}"];
 InventoryPanel [label="{{game.view.InventoryPanel|+open(GameProgress): void}}"];
 Battle [label="{{game.model.Battle|-party: List<Student>|-enemies: List<Enemy>|+attack(Enemy): boolean|+ability(Student, Enemy): boolean}}"];
 Progress [label="{{game.model.GameProgress|-party: List<Student>|-inventory: Inventory|+getInventory(): Inventory}}"];
 Inventory [label="{{game.model.Inventory|-items: ItemBag<Item>|+getItems(): List<Item>}}"];
 Bag [label="{{game.model.ItemBag<T extends Item>|-items: List<T>|+add(T): void|+items(): List<T>}}"];
 Character [label="{{«abstract» GameCharacter|+getName(): String|+getAttack(): int|+isAlive(): boolean}}"];
 Student [label="{{Student|+getAbilityType(): AbilityType}}"];
 Enemy [label="{{Enemy|+isAlive(): boolean}}"];
 Item [label="{{«abstract» Item|+getName(): String|+getCategory(): String}}"];
 SaveStore [label="{{game.io.SaveStore|+save(int, Format, GameProgress): void|+load(int, Format): GameProgress}}"];
 EnemyActions [label="{{BattleEnemyActions|enemy abilities}}"];
 EncounterFactory [label="{{EncounterFactory|encounter construction}}"];
 Clock [label="{{BattleClock|action-bar scheduling}}"];
 Renderers [label="{{Battle renderers|BattleHudRenderer|BattleSpritesRenderer|BattleEffectsRenderer}}"];
 CampStatus [label="{{CampStatusRenderer|status and allocation overlays}}"];
 TextEncoder [label="{{SaveTextEncoder|text save encoding}}"];
 Battle -> EnemyActions [style=dashed,arrowhead=vee]; Battle -> EncounterFactory [style=dashed,arrowhead=vee];
 BattlePanel -> Clock [style=dashed,arrowhead=vee]; BattleScene -> Renderers [style=dashed,arrowhead=vee];
 Camp -> CampStatus [style=dashed,arrowhead=vee]; SaveStore -> TextEncoder [style=dashed,arrowhead=vee];
 BattleRegeneration [label="{{BattleRegeneration|HP and SP regeneration}}"];
 VictoryRewards [label="{{BattleVictoryRewards|victory rewards}}"];
 Battle -> BattleRegeneration [style=dashed,arrowhead=vee];
 BattlePanel -> VictoryRewards [style=dashed,arrowhead=vee];
 BattleDotEngine [label="{{BattleDotEngine|damage-over-time effects}}"];
 Battle -> BattleDotEngine [style=dashed,arrowhead=vee];
 BattleTargetRules [label="{{BattleTargetRules|target eligibility}}"];
 BattlePanel -> BattleTargetRules [style=dashed,arrowhead=vee];
 BattleHeroActions [label="{{BattleHeroActions|hero attacks}}"];
 Battle -> BattleHeroActions [style=dashed,arrowhead=vee];
 BattleEnemyDamage [label="{{BattleEnemyDamage|enemy damage}}"];
 Battle -> BattleEnemyDamage [style=dashed,arrowhead=vee];
 BattleEnemyFollowups [label="{{BattleEnemyFollowups|delayed enemy attacks}}"];
 Battle -> BattleEnemyFollowups [style=dashed,arrowhead=vee];
 BattleEscape [label="{{BattleEscape|escape}}"];
 Battle -> BattleEscape [style=dashed,arrowhead=vee];
 BattleItems [label="{{BattleItems|battle consumables}}"];
 Battle -> BattleItems [style=dashed,arrowhead=vee];
 BattleActionFlow [label="{{BattleActionFlow|delayed actions}}"];
 BattlePanel -> BattleActionFlow [style=dashed,arrowhead=vee];
 BattleInput [label="{{BattleInput|keyboard input}}"];
 BattlePanel -> BattleInput [style=dashed,arrowhead=vee];
 BattleViewState [label="{{BattleViewState|battlefield state}}"];
 BattlePanel -> BattleViewState [style=dashed,arrowhead=vee];
 BattleHudController [label="{{BattleHudController|HUD updates}}"];
 BattlePanel -> BattleHudController [style=dashed,arrowhead=vee];
 Main -> BattlePanel [style=dotted,label="creates"];
 Main -> Camp [style=dotted,label="creates"];
 Main -> InventoryPanel [style=dotted,label="creates"];
 Main -> SaveStore [style=dotted,label="creates"];
 BattlePanel -> Battle [arrowhead=vee]; BattlePanel -> BattleScene [arrowhead=vee];
 BattleScene -> Overlays [arrowhead=vee];
 Camp -> Progress [arrowhead=vee]; InventoryPanel -> Progress [arrowhead=vee];
 Battle -> Progress [arrowhead=vee]; Battle -> Student [arrowhead=vee]; Battle -> Enemy [arrowhead=vee];
 Progress -> Inventory [arrowhead=vee]; Progress -> Student [arrowhead=vee]; Inventory -> Bag [arrowhead=vee]; Bag -> Item [arrowhead=vee];
 Student -> Character [arrowhead=empty]; Enemy -> Character [arrowhead=empty];
 SaveStore -> Progress [style=dashed,arrowhead=vee];
}
