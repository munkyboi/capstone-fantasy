"game.io.SaveStore" [label="{SaveStore|-directory: Path\l…\l|+defaultDirectory(): Path\l+exists(int, Format): boolean\l+save(int, Format, GameProgress): void\l+load(int, Format): GameProgress\l}"];
"game.io.SaveStore.Format" [label="{«enum» SaveStore.Format|…\l|}"];
